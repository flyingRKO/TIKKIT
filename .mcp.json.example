{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://<DB_USERNAME>:<DB_PASSWORD>@localhost:5432/tikkit_db"
      ]
    }
  }
}
