# docker-compose.prod.yml용 환경변수 (Task 024).
# 사용법:  cp .env.example .env
#
# tikkit-back/.env(개발 인프라용)와는 별개 파일이다. 루트 .env는 .gitignore에 이미 들어 있다.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# 로컬 검증 편의상 tikkit-back/.env와 같은 값을 쓴다 (운영이라면 당연히 바꾼다).
POSTGRES_DB=tikkit_db
POSTGRES_USER=tikkit_user
POSTGRES_PASSWORD=tikkit_pass

# ── Flyway ─────────────────────────────────────────────────────────────────
# Task 024의 완료 기준이 "prod 이미지로 띄운 스택에서 Playwright e2e 3개 통과"다.
# e2e는 시드 계정(user@tikkit.com)과 "판매중" 공연이 필요하므로 로컬 검증에서는 시드를 켠다.
# 진짜 운영이라면 이 줄을 주석 처리해 기본값(classpath:db/migration)을 쓴다.
#
# 주의: 이 값을 바꾼 뒤에는 반드시 볼륨을 비워야 한다.
#   docker compose -f docker-compose.prod.yml down -v
# db/seed의 버전이 V1_1, V4_1, V5_1로 db/migration 사이에 끼어 있어서, 이미 시드가 적용된
# 스키마에 시드 없는 설정으로 붙으면 Flyway가 기동을 거부한다.
#
# 또 하나: 시드의 "판매중" 회차는 적용 시점 기준 상대 날짜(now() + 15~27일)다. 볼륨을 만든 지
# 27일이 지나면 ON_SALE 공연이 0개가 되어 e2e가 깨진다. e2e를 돌릴 땐 볼륨을 새로 만든다.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# ── CORS ───────────────────────────────────────────────────────────────────
# 콤마로 여러 개 가능. 브라우저는 BE를 직접 호출하지 않으므로 지금은 쓰이지 않는 설정이다.
# allowCredentials(true)와 함께라서 "*"는 쓸 수 없다 (넣으면 기동이 깨진다).
#
# Task 026에서 포트가 3000 -> 80으로 바뀌었다. nginx가 FE와 BE를 한 포트에서 서빙하므로
# 브라우저 입장에서는 same-origin이 되고, CORS가 발동할 여지는 더 줄었다.
CORS_ALLOWED_ORIGINS=http://localhost

# ── Redis ──────────────────────────────────────────────────────────────────
# RedissonClient를 주입받는 프로덕션 코드가 아직 0건이라 false가 기본이다.
# true로 바꾸면 Redisson이 기동 시점에 바로 접속한다 (Task 029 캐싱 / 031 대기열에서 켠다).
REDIS_ENABLED=false

# ── 세션 저장소 (Task 026) ─────────────────────────────────────────────────
# 인증 상태를 어디에 두는가. memory | redis
#
# redis가 운영 기본값이다. BE가 2대라서 memory로 띄우면 세션 불일치가 난다 —
# 같은 쿠키로 /members/me를 반복하면 200과 401이 섞여 나온다(실측 46% 성공).
# 그 재현을 직접 보고 싶으면 일부러 memory로 바꿔 띄운다.
# REDIS_ENABLED와는 별개 토글이다(그쪽은 Redisson용이고 지금 주입처가 0건이다).
#
# 값을 바꾼 뒤에는 BE를 재생성하게 되므로 nginx도 같이 재시작해야 한다:
#   docker compose -f docker-compose.prod.yml up -d backend1 backend2
#   docker compose -f docker-compose.prod.yml restart nginx
# nginx가 upstream 호스트명을 기동 시 1회만 해석해서, 안 하면 옛 IP로 502를 뱉는다.
AUTH_SESSION_STORE=redis

# ── 조회 캐시 (Task 029) ───────────────────────────────────────────────────
# none | caffeine | redis
#
# 기본값이 none이다. 캐시는 before/after를 비교해 채택을 판정하는 대상이라, 스택을 띄우는
# 것만으로 켜지면 "캐시 없는 기준선"을 다시 재기 어렵다. 측정 군을 바꿀 때 이 값을 바꾼다.
#   none     : 캐시 없음 (기준선)
#   caffeine : JVM 로컬 캐시. BE 2대의 캐시가 갈린다 — 만료 배치가 ShedLock으로 한 대에서만
#              돌아서 evict가 반쪽만 적용되고, 다른 BE는 TTL 60초까지 옛 status를 내려준다
#   redis    : 공유 캐시. evict 한 번이 전체에 반영된다 (운영 후보)
#
# 캐시 대상과 제외 대상은 tikkit-back/src/main/java/.../config/CacheNames.java에 있다.
# 좌석 상태와 잔여 수량은 캐시하지 않는다 — 예매마다 바뀌는 값이다.
CACHE_TYPE=none

# 좌석맵 "응답 바이트" 캐시 TTL. 0이면 비활성이고 그게 기본값이다.
#
# 서비스 레이어 캐시로는 Jackson 직렬화 비용을 줄일 수 없어서(캐시가 돌려주는 건 객체고
# 컨트롤러가 반환하면 다시 직렬화된다), 그 비용의 상한을 재려고 만든 실험 스위치다.
# 켜면 좌석 상태가 이 시간만큼 stale해진다 — 오픈런에서 이미 선점된 좌석을 보여주면
# 선점 요청이 409로 튕긴다. 운영에서 켜지 않는다.
CACHE_SEATMAP_RESPONSE_TTL=0s

# Redis 메모리 상한 (Task 029). 세션과 캐시가 같은 인스턴스를 쓴다.
# 축출 정책은 allkeys-lru로 고정돼 있어서, 캐시가 상한을 채우면 세션 키도 축출될 수 있다
# (= 로그인이 임의로 풀린다). 근거와 대안은 docker-compose.prod.yml의 redis 서비스 주석 참조.
REDIS_MAXMEMORY=512mb

# ── 모니터링 (Task 025) ────────────────────────────────────────────────────
# --profile monitoring으로 띄울 때만 쓰인다. Grafana는 http://localhost:3001
# (기본 포트 3000은 tikkit-front가 쓴다). 익명 조회가 켜져 있어 로그인 없이도 볼 수 있고,
# 이 비밀번호는 패널을 고칠 때만 필요하다.
GRAFANA_ADMIN_PASSWORD=admin

# 구조화(JSON) 콘솔 로깅. 기본은 사람이 읽는 텍스트다 — compose logs를 직접 읽는
# 로컬 워크플로우에서 JSON은 가독성이 크게 떨어진다. 값은 ecs / logstash / gelf.
# 수집기(Loki/ELK)를 붙이는 Task 034에서 켠다.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
