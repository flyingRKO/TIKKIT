# docker-compose.prod.yml용 환경변수 (Task 024).
# 사용법:  cp .env.example .env
#
# tikkit-back/.env(개발 인프라용)와는 별개 파일이다. 루트 .env는 .gitignore에 이미 들어 있다.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# 로컬 검증 편의상 tikkit-back/.env와 같은 값을 쓴다 (운영이라면 당연히 바꾼다).
POSTGRES_DB=tikkit_db
POSTGRES_USER=tikkit_user
POSTGRES_PASSWORD=tikkit_pass

# ── Flyway ─────────────────────────────────────────────────────────────────
# Task 024의 완료 기준이 "prod 이미지로 띄운 스택에서 Playwright e2e 3개 통과"다.
# e2e는 시드 계정(user@tikkit.com)과 "판매중" 공연이 필요하므로 로컬 검증에서는 시드를 켠다.
# 진짜 운영이라면 이 줄을 주석 처리해 기본값(classpath:db/migration)을 쓴다.
#
# 주의: 이 값을 바꾼 뒤에는 반드시 볼륨을 비워야 한다.
#   docker compose -f docker-compose.prod.yml down -v
# db/seed의 버전이 V1_1, V4_1, V5_1로 db/migration 사이에 끼어 있어서, 이미 시드가 적용된
# 스키마에 시드 없는 설정으로 붙으면 Flyway가 기동을 거부한다.
#
# 또 하나: 시드의 "판매중" 회차는 적용 시점 기준 상대 날짜(now() + 15~27일)다. 볼륨을 만든 지
# 27일이 지나면 ON_SALE 공연이 0개가 되어 e2e가 깨진다. e2e를 돌릴 땐 볼륨을 새로 만든다.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# ── CORS ───────────────────────────────────────────────────────────────────
# 콤마로 여러 개 가능. 브라우저는 BE를 직접 호출하지 않으므로 지금은 쓰이지 않는 설정이다.
# allowCredentials(true)와 함께라서 "*"는 쓸 수 없다 (넣으면 기동이 깨진다).
#
# Task 026에서 포트가 3000 -> 80으로 바뀌었다. nginx가 FE와 BE를 한 포트에서 서빙하므로
# 브라우저 입장에서는 same-origin이 되고, CORS가 발동할 여지는 더 줄었다.
CORS_ALLOWED_ORIGINS=http://localhost

# ── Redis ──────────────────────────────────────────────────────────────────
# 주소는 docker-compose.prod.yml이 redis://redis:6379로 고정한다. 연결을 켜는 토글은
# 용도별로 따로다 — 아래 AUTH_SESSION_STORE(세션), CACHE_TYPE(조회 캐시), QUEUE_ENABLED(대기열).
# Task 020이 쓰던 REDIS_ENABLED(Redisson)는 Task 031에서 제거했다.

# ── 세션 저장소 (Task 026) ─────────────────────────────────────────────────
# 인증 상태를 어디에 두는가. memory | redis
#
# redis가 운영 기본값이다. BE가 2대라서 memory로 띄우면 세션 불일치가 난다 —
# 같은 쿠키로 /members/me를 반복하면 200과 401이 섞여 나온다(실측 46% 성공).
# 그 재현을 직접 보고 싶으면 일부러 memory로 바꿔 띄운다.
#
# 값을 바꾼 뒤에는 BE를 재생성하게 되므로 nginx도 같이 재시작해야 한다:
#   docker compose -f docker-compose.prod.yml up -d backend1 backend2
#   docker compose -f docker-compose.prod.yml restart nginx
# nginx가 upstream 호스트명을 기동 시 1회만 해석해서, 안 하면 옛 IP로 502를 뱉는다.
AUTH_SESSION_STORE=redis

# ── 조회 캐시 (Task 029) ───────────────────────────────────────────────────
# none | redis
#
# 기본값이 none이다. 캐시는 before/after를 비교해 채택을 판정하는 대상이라, 스택을 띄우는
# 것만으로 켜지면 "캐시 없는 기준선"을 다시 재기 어렵다.
#   none  : 캐시 없음. NoOpCacheManager라 @Cacheable이 전부 통과만 한다
#   redis : 공유 캐시. evict 한 번이 전 인스턴스에 반영된다 (운영 후보)
#
# 캐시 대상은 공연 목록·상세와 등급 가격뿐이다(CacheNames.java). 좌석 상태와 잔여 수량은
# 예매마다 바뀌어서 캐시하지 않고, **좌석맵은 캐싱 자체를 기각했다** — 항목이 2,000석에
# 337,885바이트라 Redis 왕복·역직렬화가 원래 쿼리보다 비쌌고 적중률 99.97%에서도 느렸다
# (docs/improvements/008-caching.md 4절).
#
# 참고: 현 규모에서는 켜도 p95가 좋아지지 않는다. 채택 근거는 지연이 아니라 용량이고
# (히트가 DB 왕복을 없앤다) 그 검증은 Task 033 포화 테스트가 한다. 로컬 캐시(Caffeine)도
# 비교하고 기각했다 — 근거는 CacheProperties Javadoc.
CACHE_TYPE=none

# ── 대기열 (Task 031) ──────────────────────────────────────────────────────
# true | false
#
# 기본값이 false다. CACHE_TYPE과 같은 이유 — 대기열은 "유무에 따른 before/after"를 비교해
# 효과를 판정하는 대상이라(Task 033), 스택을 띄우는 것만으로 켜지면 무방비 기준선을 다시
# 재기 어렵다. false면 DisabledQueueGateway가 올라가 전부 통과시킨다.
#
# 토글이 두 층이다. 둘 다 켜져야 줄이 선다:
#   QUEUE_ENABLED            대기열 기능이 이 애플리케이션에 있는가
#   schedules.queue_enabled  이 회차에 줄을 세우는가 (V8, 사람이 SQL로 켠다)
# 회차 플래그는 load-test/sql/04-enable-queue.sql로 켠다. QueueFlagRegistry의 스냅샷
# TTL이 10초라서 SQL을 돌린 뒤 반영까지 최대 10초 걸린다.
#
# 값을 바꾼 뒤에는 AUTH_SESSION_STORE와 똑같이 backend 재생성 + nginx 재시작이 필요하다:
#   docker compose -f docker-compose.prod.yml up -d backend1 backend2
#   docker compose -f docker-compose.prod.yml restart nginx
QUEUE_ENABLED=false

# 한 틱에 입장시킬 인원 / 틱 간격.
#
# 50은 Task 031이 박아둔 측정 전 임시값이고 근거가 없다 — Task 033이 포화점(좌석 조회와
# 선점이 p95 안에 처리되는 최대 RPS)을 재서 정한다. 군을 바꿀 때마다 이미지를 다시 빌드하지
# 않으려고 환경변수로 뺐다.
#
# 주의 둘:
#   1) INTERVAL을 1s에서 크게 바꾸면 QueueAdmissionScheduler의 @SchedulerLock(lockAtLeastFor)도
#      같이 봐야 한다. 어노테이션에 계산식을 쓸 수 없어 두 값이 수동으로 묶여 있고, 안 맞추면
#      "설정은 5초인데 실제로는 1초마다 입장"이 된다.
#   2) 예상 대기시간이 rank / (BATCH_SIZE / INTERVAL)이라, 좌석 API를 지키려고 배치를 줄이면
#      화면의 ETA가 그만큼 길어진다. 사용자에게 바로 보이는 트레이드오프다.
QUEUE_ADMIT_BATCH_SIZE=50
QUEUE_ADMIT_INTERVAL=1s

# Redis 메모리 상한 (Task 029). 세션과 캐시가 같은 인스턴스를 쓴다.
# OOM 가드 용도다 — 조회 캐시는 카탈로그 전체가 올라와도 수십 MB라서 이 값을 채우지 않는다
# (측정 중 피크 43.3MB, 축출 0건). 축출 정책 allkeys-lru는 세션 키도 대상이라서,
# Task 031 대기열이 들어와 메모리가 커지면 세션과 분리할지 다시 판단한다.
REDIS_MAXMEMORY=512mb

# ── 모니터링 (Task 025) ────────────────────────────────────────────────────
# --profile monitoring으로 띄울 때만 쓰인다. Grafana는 http://localhost:3001
# (기본 포트 3000은 tikkit-front가 쓴다). 익명 조회가 켜져 있어 로그인 없이도 볼 수 있고,
# 이 비밀번호는 패널을 고칠 때만 필요하다.
GRAFANA_ADMIN_PASSWORD=admin

# 구조화(JSON) 콘솔 로깅. 기본은 사람이 읽는 텍스트다 — compose logs를 직접 읽는
# 로컬 워크플로우에서 JSON은 가독성이 크게 떨어진다. 값은 ecs / logstash / gelf.
# 수집기(Loki/ELK)를 붙이는 Task 034에서 켠다.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# ── DB 커넥션 풀 (Task 033) ────────────────────────────────────────────────
# Hikari maximumPoolSize. 비워두면 Hikari 기본값과 같은 10이다.
#
# **이 값을 올려도 처리량이 오르지 않는다 — Task 033에서 측정으로 확인했다.**
# 10/20/30 모두 약 365 req/s에서 똑같이 막혔고, 도착률 140/s에서는 오히려 올린 쪽이
# 느렸다 (좌석 API p95 214 -> 280 -> 311ms). 풀 소진과 커넥션 대기(pending)는 포화의
# 원인이 아니라 증상이었다 — 실제 벽은 CPU다. 240/s에서 16코어 중 11.4개를 쓴다
# (측정 결과는 docs/improvements/010-waiting-queue.md).
#
# 그래서 이 변수는 "기준선을 다시 재기 위한 측정용 손잡이"로만 남는다. 운영에서
# 올릴 근거는 이 측정에 없다.
#
# 상한은 Postgres max_connections(기본 100)다. BE 2대이므로 한 대당 50이 한계다.
DB_POOL_SIZE=10

