# Claude Code 개인 설정 (로컬 전용)
.claude/settings.local.json
CLAUDE.local.md

# MCP 설정 (DB 접속문자열 등 자격증명 포함, 개인 환경별로 다름)
.mcp.json

# 환경 변수
.env
.env.local
.env.*.local

# IntelliJ IDEA (전부 무시 — 로컬 환경에 따라 내용이 달라져 커밋에 섞인다)
.idea/

# k6 부하 테스트 결과 (실행마다 달라지고 용량이 크다 — 스크립트와 SQL은 추적한다)
load-test/results/*
# 디렉토리 자체는 추적한다. compose가 bind mount 대상을 자동 생성할 때 소유자가
# root가 되어 k6 컨테이너(uid 12345)가 결과를 못 쓰는 경우가 있다.
!load-test/results/.gitkeep

# Python 바이트코드 캐시 (스킬 스크립트 실행 시 생성 — 인터프리터 버전에 묶여 재사용 불가)
__pycache__/
*.pyc

# 모노레포 루트에서 npm 명령을 돌리면 의존성 없는 빈 lockfile이 생긴다.
# 그게 있으면 Next가 워크스페이스 루트를 여기로 추정해 dev CSS 컴파일이 깨진다
# (tikkit-front/next.config.ts의 turbopack.root 주석 참조). 다시 커밋되지 않게 막는다.
/package-lock.json

# 로컬 TLS 인증서 (Task 039_1 — HTTP/2는 TLS가 선행이고 브라우저는 평문 h2c를 지원하지 않는다).
# 기계마다 다시 만들면 되는 것이라 추적하지 않는다. 만드는 법은 nginx/generate-local-cert.sh다.
nginx/certs/*
!nginx/certs/.gitkeep
